# Dedicated WebSteps Supabase project values go in dist/account-config.js.
# Only the URL and publishable key belong in the browser; never use a secret key there.
WEBSTEPS_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
WEBSTEPS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Edge Functions use the managed Supabase URL, publishable-key, and secret-key environment variables.
